import numpy as np


list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]
arr = np.array(list)

arr_4 = arr * 4
print(arr_4)

arr_mean = np.mean(arr)
print(arr_mean)

arr_median = np.median(arr)
print(arr_median)

arr_standard_deviation = np.std(arr)
print(arr_standard_deviation)

arr_argmax = np.argmax(arr)
print(arr_argmax)

arr_argmin = np.argmin(arr)
print(arr_argmin)

print(arr[arr_argmax])
print(arr[arr_argmin])

arr_greater_than_20 = arr[arr > 20]
print(arr_greater_than_20)


